FROM python:3.14-slim AS base

LABEL org.opencontainers.image.title="AI Agent Security Lab — Agent" \
      org.opencontainers.image.description="Autonomous security research agent with sandboxed tools, guardrails, and audit logging. Part of the AI Agent Security Testing Lab." \
      org.opencontainers.image.url="https://github.com/jmsD3v/ai-agent-security-lab" \
      org.opencontainers.image.source="https://github.com/jmsD3v/ai-agent-security-lab" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="AI Agent Security Lab" \
      security.owasp.coverage="LLM01,LLM02,LLM04,LLM05,LLM06,LLM07,LLM08,LLM10" \
      security.mitre.atlas="AML.T0051,AML.T0048,AML.T0043,AML.T0034"

# Non-root user — mínimo privilegio

# Parches de seguridad del sistema base (Debian) que todavía no estén en la imagen oficial
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN addgroup --gid 1001 agent && \
    adduser --uid 1001 --gid 1001 --disabled-password --gecos "" agent

WORKDIR /app

# Dependencias primero (cache layer)
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir -e ".[dev]" "urllib3>=2.8" "msgpack>=1.2"

# Código fuente
COPY agent/ ./agent/
COPY monitor/ ./monitor/
COPY defense/ ./defense/
COPY attacks/ ./attacks/
COPY reports/ ./reports/

# Sandbox filesystem — aislado del host
RUN mkdir -p /sandbox/data /sandbox/vuln-db && \
    chown -R agent:agent /sandbox && \
    chmod 750 /sandbox/data

# Reports dir
RUN mkdir -p /app/reports && chown agent:agent /app/reports

USER agent

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD python -c "from agent.agent import Agent; print('ok')"

CMD ["python", "-m", "agent.agent"]
