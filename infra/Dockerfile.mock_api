FROM python:3.14-slim

LABEL org.opencontainers.image.title="AI Agent Security Lab — Mock API" \
      org.opencontainers.image.description="Mock vulnerability database API with honeypot endpoints for agent security testing. Part of the AI Agent Security Testing Lab." \
      org.opencontainers.image.url="https://github.com/jmsD3v/ai-agent-security-lab" \
      org.opencontainers.image.source="https://github.com/jmsD3v/ai-agent-security-lab" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="AI Agent Security Lab"


# Parches de seguridad del sistema base (Debian) que todavía no estén en la imagen oficial
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN addgroup --gid 1002 mockapi && \
    adduser --uid 1002 --gid 1002 --disabled-password --gecos "" mockapi

WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir -e . "urllib3>=2.8"
COPY mock_api/ ./mock_api/

USER mockapi

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"

CMD ["uvicorn", "mock_api.server:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "warning"]
