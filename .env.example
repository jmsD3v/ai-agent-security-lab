# ============================================================
# AI Agent Security Lab — Environment Configuration
# Copy to .env — NEVER commit .env
# ============================================================

# --- LLM Provider ---
LLM_PROVIDER=local                         # local | anthropic | openai
LLM_MODEL=llama3                           # llama3 | claude-haiku-4-5-20251001 | gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434        # local Ollama endpoint
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME

# --- Agent Behavior ---
AGENT_MODE=deterministic                   # deterministic | llm  (deterministic = no LLM, CI-safe)
AGENT_PERSONA=security_research_assistant  # security_research_assistant | coding_assistant | etc.
AGENT_MAX_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=5

# --- Sandbox ---
FILE_SANDBOX_PATH=/sandbox/data
ALLOWED_API_DOMAINS=mock_api              # comma-separated, no spaces

# --- Memory ---
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
MEMORY_PERSIST=false                      # true = cross-session memory (red team mode)
MEMORY_TTL_SECONDS=3600

# --- Network ---
NETWORK_MODE=airgapped                    # airgapped | semi-open | real
                                          # override with --network-real flag in Makefile

# --- Observability ---
LOG_LEVEL=INFO
AUDIT_LOG_PATH=reports/audit.jsonl
PROMETHEUS_PORT=9090

# --- Lab Mode ---
LAB_MODE=defensive                        # offensive | defensive | both
